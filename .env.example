# ─────────────────────────────────────────────
# Creative Intelligence — Shopify product sync (read-only)
# ─────────────────────────────────────────────
# Set CI_SHOPIFY_ENABLED=1 to activate Shopify product sync.
CI_SHOPIFY_ENABLED=0

# Your store URL, e.g. "mystore.myshopify.com" or "https://mystore.myshopify.com"
SHOPIFY_STORE_URL=

# Shopify Admin API access token (needs read_products scope only)
# Create in Shopify Admin → Apps → Develop apps → API credentials
SHOPIFY_ACCESS_TOKEN=

# Shopify Admin API version (default: 2024-01; update quarterly)
SHOPIFY_API_VERSION=2024-01

# ─────────────────────────────────────────────
# Creative Intelligence — LLM providers (optional)
# ─────────────────────────────────────────────
# Set one or both to enable real generation (falls back to mock if neither set)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model to use for generation (default: gpt-4o-mini)
CI_LLM_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────
# Creative Intelligence — Test UI (web/app.py)
# ─────────────────────────────────────────────
# Port for the local creative testing UI (default: 5555)
CI_WEB_PORT=5555

# ─────────────────────────────────────────────
# Creative Intelligence — Static Rendering (v1.4)
# ─────────────────────────────────────────────
# Image generation provider: "mock" (default, no API calls) | "nano_banana"
CI_IMAGE_PROVIDER=mock

# Set to "1" to enable real image generation API calls (default: off = spec-only mode)
CI_IMAGE_GENERATION_ENABLED=0

# Local directory where generated image files are saved (default: creative_intelligence_data/render_outputs/)
CI_RENDER_OUTPUT_DIR=

# Nano Banana credentials (only required when CI_IMAGE_PROVIDER=nano_banana)
CI_NANO_BANANA_API_KEY=
CI_NANO_BANANA_ENDPOINT=https://api.nanobanana.io/v1/generate

# Replicate credentials (only required when CI_IMAGE_PROVIDER=replicate)
CI_REPLICATE_API_KEY=r8_...
# Default model — override with any Replicate image model slug
CI_REPLICATE_MODEL=stability-ai/stable-diffusion-3.5-large-turbo
